{
  "timeout": 60,
  "window": { "width": 1280, "height": 800 },
  "steps": [
    { "do": "startLibrary" },
    { "do": "waitUntil", "path": "library.scanning", "equals": false, "timeout": 10 },
    { "do": "assert", "path": "library.liked", "equals": ["夜に駆ける"] },
    { "do": "sidebar", "value": "liked" },
    { "do": "assert", "path": "ui.firstRows", "equals": ["夜に駆ける"] }
  ]
}
