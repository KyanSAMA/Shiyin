{
  "timeout": 90,
  "window": { "width": 1280, "height": 800 },
  "steps": [
    { "do": "fs", "op": "copy", "from": "@fixtures/library", "to": "@out/lib" },
    { "do": "startLibrary", "include": ["@out/lib"], "exclude": ["@out/lib/Music"] },
    { "do": "play", "title": "夜に駆ける" },
    { "do": "miniPlayer" },
    { "do": "assert", "path": "windows.mini.visible", "equals": true },
    { "do": "assert", "path": "windows.mini.floating", "equals": true },
    { "do": "assert", "path": "windows.mini.allSpaces", "equals": true },
    { "do": "assert", "path": "windows.mini.nonactivating", "equals": true },
    { "do": "assert", "path": "windows.mini.hidesOnDeactivate", "equals": false },
    { "do": "assert", "path": "windows.mini.width", "equals": 360 },
    { "do": "assert", "path": "windows.mini.height", "equals": 108 },
    { "do": "waitUntil", "path": "lyrics.index", "equals": 4, "timeout": 6 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "snapshot", "name": "mini", "window": "mini" },
    { "do": "assert", "path": "snapshots.mini.isLikelyBlank", "equals": false },

    { "do": "pressKey", "key": "space" },
    { "do": "assert", "path": "player.isPlaying", "equals": false },
    { "do": "snapshot", "name": "mini-paused", "window": "mini" },
    { "do": "pressKey", "key": "space" },
    { "do": "assert", "path": "player.isPlaying", "equals": true },
    { "do": "pressKey", "key": "space", "modifiers": ["shift"] },
    { "do": "pressKey", "key": "space", "repeat": true },
    { "do": "assert", "path": "player.isPlaying", "equals": true },

    { "do": "pressKey", "key": "right", "modifiers": ["command"] },
    { "do": "assert", "path": "player.title", "equals": "群青" },
    { "do": "pressKey", "key": "left", "modifiers": ["command"] },
    { "do": "assert", "path": "player.title", "equals": "夜に駆ける" },
    { "do": "pressKey", "key": "down", "modifiers": ["command"] },
    { "do": "assert", "path": "player.volume", "approx": 0.9, "tol": 0.001 },
    { "do": "pressKey", "key": "up", "modifiers": ["command"] },
    { "do": "assert", "path": "player.volume", "approx": 1.0, "tol": 0.001 },
    { "do": "pressKey", "key": "m", "modifiers": ["option", "command"] },
    { "do": "assert", "path": "windows.mini.visible", "equals": false },
    { "do": "pressKey", "key": "m", "modifiers": ["option", "command"] },
    { "do": "assert", "path": "windows.mini.visible", "equals": true },
    { "do": "pressKey", "key": "l", "modifiers": ["command"] },
    { "do": "assert", "path": "ui.nowPlaying", "equals": true },
    { "do": "pressKey", "key": "l", "modifiers": ["command"] },
    { "do": "assert", "path": "ui.nowPlaying", "equals": false },

    { "do": "pressKey", "key": "f", "modifiers": ["command"] },
    { "do": "assert", "path": "ui.searchFocused", "equals": true },
    { "do": "pressKey", "key": "right", "modifiers": ["command"] },
    { "do": "pressKey", "key": "left", "modifiers": ["command"] },
    { "do": "pressKey", "key": "down", "modifiers": ["command"] },
    { "do": "pressKey", "key": "left", "modifiers": ["shift", "command"] },
    { "do": "assert", "path": "player.title", "equals": "夜に駆ける" },
    { "do": "assert", "path": "player.volume", "approx": 1.0, "tol": 0.001 },
    { "do": "pressKey", "key": "space" },
    { "do": "assert", "path": "player.isPlaying", "equals": true },
    { "do": "assert", "path": "ui.search", "equals": " " },

    { "do": "showNowPlaying" },
    { "do": "assert", "path": "ui.searchFocused", "equals": false },
    { "do": "pressKey", "key": "space" },
    { "do": "assert", "path": "player.isPlaying", "equals": false },
    { "do": "assert", "path": "ui.search", "equals": " " },
    { "do": "focusSearch" },
    { "do": "assert", "path": "ui.nowPlaying", "equals": false },
    { "do": "assert", "path": "ui.searchFocused", "equals": true },

    { "do": "closeMainWindow" },
    { "do": "assert", "path": "windows.mini.visible", "equals": true },
    { "do": "openMainWindow" },
    { "do": "assert", "path": "windows.main.visible", "equals": true },
    { "do": "miniPlayer", "value": false },
    { "do": "assert", "path": "windows.mini.visible", "equals": false },
    { "do": "closeMainWindow" },
    { "do": "wait", "seconds": 1 },
    { "do": "assert", "path": "player.isPlaying", "equals": false },
    { "do": "pressKey", "key": "f", "modifiers": ["command"] },
    { "do": "assert", "path": "windows.main.visible", "equals": true },
    { "do": "assert", "path": "ui.searchFocused", "equals": true },
    { "do": "state", "name": "end" }
  ]
}
