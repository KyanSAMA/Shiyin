{
  "timeout": 120,
  "window": { "width": 1280, "height": 800 },
  "steps": [
    {"do": "startLibrary"},
    {"do": "waitUntil", "path": "library.scanning", "equals": false, "timeout": 30},
    {"do": "wait", "seconds": 1},
    {"do": "perfReset"},
    {"do": "sidebar", "value": "albums"},
    {"do": "wait", "seconds": 0.5},
    {"do": "state", "name": "nav-albums"},
    {"do": "assert", "path": "perf.maxMainThreadStallMs", "lt": 250},
    {"do": "perfReset"},
    {"do": "openAlbum", "title": "迷跡波"},
    {"do": "wait", "seconds": 0.5},
    {"do": "state", "name": "nav-open-album"},
    {"do": "assert", "path": "perf.maxMainThreadStallMs", "lt": 400},
    {"do": "perfReset"},
    {"do": "back"},
    {"do": "wait", "seconds": 0.5},
    {"do": "state", "name": "nav-back"},
    {"do": "assert", "path": "perf.maxMainThreadStallMs", "lt": 100},
    {"do": "perfReset"},
    {"do": "sidebar", "value": "artists"},
    {"do": "wait", "seconds": 0.5},
    {"do": "state", "name": "nav-artists"},
    {"do": "assert", "path": "perf.maxMainThreadStallMs", "lt": 250},
    {"do": "perfReset"},
    {"do": "openPerson", "name": "YOASOBI"},
    {"do": "wait", "seconds": 0.5},
    {"do": "state", "name": "nav-open-person"},
    {"do": "assert", "path": "perf.maxMainThreadStallMs", "lt": 400},
    {"do": "perfReset"},
    {"do": "sidebar", "value": "composers"},
    {"do": "wait", "seconds": 0.5},
    {"do": "state", "name": "nav-composers"},
    {"do": "assert", "path": "perf.maxMainThreadStallMs", "lt": 250},
    {"do": "perfReset"},
    {"do": "sidebar", "value": "songs"},
    {"do": "wait", "seconds": 0.5},
    {"do": "state", "name": "nav-songs"},
    {"do": "assert", "path": "perf.maxMainThreadStallMs", "lt": 400},
    {"do": "perfReset"},
    {"do": "sort", "column": "artist"},
    {"do": "wait", "seconds": 0.5},
    {"do": "state", "name": "sort-artist"},
    {"do": "assert", "path": "perf.maxMainThreadStallMs", "lt": 400},
    {"do": "perfReset"},
    {"do": "sort", "column": "year", "ascending": false},
    {"do": "wait", "seconds": 0.5},
    {"do": "state", "name": "sort-year"},
    {"do": "assert", "path": "perf.maxMainThreadStallMs", "lt": 400},
    {"do": "perfReset"},
    {"do": "filter", "hiRes": true},
    {"do": "wait", "seconds": 0.5},
    {"do": "state", "name": "filter-hires"},
    {"do": "assert", "path": "perf.maxMainThreadStallMs", "lt": 400},
    {"do": "perfReset"},
    {"do": "filter"},
    {"do": "wait", "seconds": 0.5},
    {"do": "state", "name": "filter-clear"},
    {"do": "assert", "path": "perf.maxMainThreadStallMs", "lt": 400},
    {"do": "perfReset"},
    {"do": "search", "value": "yoasobi"},
    {"do": "search", "value": ""},
    {"do": "wait", "seconds": 0.5},
    {"do": "state", "name": "search-clear"},
    {"do": "assert", "path": "perf.maxMainThreadStallMs", "lt": 400},
    {"do": "perfReset"},
    {"do": "play", "context": "songs"},
    {"do": "wait", "seconds": 0.5},
    {"do": "state", "name": "play"},
    {"do": "assert", "path": "perf.maxMainThreadStallMs", "lt": 100},
    {"do": "perfReset"},
    {"do": "showNowPlaying"},
    {"do": "wait", "seconds": 1},
    {"do": "state", "name": "nowplaying"},
    {"do": "assert", "path": "perf.maxMainThreadStallMs", "lt": 250},
    {"do": "perfReset"},
    {"do": "showNowPlaying", "value": false},
    {"do": "showQueue"},
    {"do": "wait", "seconds": 0.5},
    {"do": "state", "name": "queue"},
    {"do": "assert", "path": "perf.maxMainThreadStallMs", "lt": 250},
    {"do": "perfReset"},
    {"do": "miniPlayer"},
    {"do": "wait", "seconds": 0.5},
    {"do": "state", "name": "mini"},
    {"do": "assert", "path": "perf.maxMainThreadStallMs", "lt": 100},
    {"do": "perfReset"},
    {"do": "play", "context": "songs"},
    {"do": "wait", "seconds": 0.8},
    {"do": "state", "name": "play-queue-shown"},
    {"do": "assert", "path": "perf.maxMainThreadStallMs", "lt": 250},
    {"do": "showQueue", "value": false},
    {"do": "miniPlayer", "value": false},
    {"do": "wait", "seconds": 0.5},
    {"do": "perfReset"},
    {"do": "scrollList", "steps": 60, "interval": 0.03},
    {"do": "state", "name": "scroll-songs"},
    {"do": "assert", "path": "perf.maxMainThreadStallMs", "lt": 100}
  ]
}
