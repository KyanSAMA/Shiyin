{
  "timeout": 60,
  "window": { "width": 1440, "height": 900 },
  "relaunch": "relaunch/18-compare.json",
  "steps": [
    { "do": "fs", "op": "copy", "from": "@fixtures/library", "to": "@out/lib" },
    { "do": "startLibrary", "include": ["@out/lib"], "exclude": ["@out/lib/Music"] },
    { "do": "editInfo", "titles": ["春日影"], "keepOpen": true },
    { "do": "assert", "path": "compare.results.netease", "equals": ["春日影", "春日影 (Piano)"] },
    { "do": "assert", "path": "compare.results.itunes", "equals": ["春日影"] },
    { "do": "assert", "path": "compare.results.qq", "equals": [] },
    { "do": "assert", "path": "compare.picked.netease", "equals": "netease:2001" },
    { "do": "adopt", "source": "itunes", "field": "genre" },
    { "do": "adopt", "source": "itunes", "field": "year" },
    { "do": "adopt", "source": "itunes", "field": "cover" },
    { "do": "adopt", "source": "netease", "field": "lyrics" },
    { "do": "adopt", "source": "netease", "field": "composers" },
    { "do": "assert", "path": "compare.texts.genre", "equals": "Anime" },
    { "do": "assert", "path": "compare.texts.year", "equals": "2024" },
    { "do": "assert", "path": "compare.texts.composers", "equals": "藤田淳平" },
    { "do": "assert", "path": "compare.cover", "equals": "itunes:1700000001" },
    { "do": "assert", "path": "compare.lyrics", "equals": "netease:2001" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "snapshot", "name": "compare-light", "window": "sheet" },
    { "do": "appearance", "value": "dark" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "compare-dark", "window": "sheet" },
    { "do": "appearance", "value": "light" },
    { "do": "compareSearch", "keywords": "春日影" },
    { "do": "assert", "path": "compare.results.netease", "equals": [] },
    { "do": "saveEditInfo" },
    { "do": "inspect", "title": "春日影" },
    { "do": "assert", "path": "inspected.春日影.genre", "equals": "Anime" },
    { "do": "assert", "path": "inspected.春日影.year", "equals": 2024 },
    { "do": "assert", "path": "inspected.春日影.coverFile", "equals": true },
    { "do": "assert", "path": "inspected.春日影.hasLyrics", "equals": true },
    { "do": "assert", "path": "inspected.春日影.album", "equals": "迷跡波" },
    { "do": "assert", "path": "inspected.春日影.match", "equals": null },
    { "do": "quit" }
  ]
}
