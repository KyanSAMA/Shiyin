{
  "timeout": 150,
  "window": { "width": 1280, "height": 800 },
  "steps": [
    { "do": "fs", "op": "copy", "from": "@fixtures/loudness", "to": "@out/ln" },
    { "do": "fs", "op": "copy", "from": "@fixtures/library/Gapless", "to": "@out/ln/Gapless" },
    { "do": "startLibrary", "include": ["@out/ln"] },
    { "do": "play", "title": "Mid" },
    { "do": "waitUntil", "path": "loudness.total", "equals": 9, "timeout": 10 },
    { "do": "waitUntil", "path": "loudness.pending", "equals": 0, "timeout": 40 },
    { "do": "assert", "path": "loudness.mode", "equals": "track" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "assert", "path": "player.gainDb", "approx": 2, "tol": 0.1 },

    { "do": "setNormalization", "value": "off" },
    { "do": "play", "title": "Loud" },
    { "do": "waitUntil", "path": "player.position", "gt": 0.3, "timeout": 3 },
    { "do": "measure", "name": "off-loud", "seconds": 2.5 },
    { "do": "assert", "path": "measure.off-loud.integratedLufs", "approx": -8, "tol": 0.5 },
    { "do": "play", "title": "Quiet" },
    { "do": "waitUntil", "path": "player.position", "gt": 0.3, "timeout": 3 },
    { "do": "measure", "name": "off-quiet", "seconds": 2.5 },
    { "do": "assert", "path": "measure.off-quiet.integratedLufs", "approx": -30, "tol": 0.5 },
    { "do": "play", "title": "Mid" },
    { "do": "waitUntil", "path": "player.position", "gt": 0.3, "timeout": 3 },
    { "do": "measure", "name": "off-mid", "seconds": 2.5 },
    { "do": "assert", "path": "measure.off-mid.integratedLufs", "approx": -20, "tol": 0.5 },
    { "do": "play", "title": "Mono" },
    { "do": "waitUntil", "path": "player.position", "gt": 0.3, "timeout": 3 },
    { "do": "measure", "name": "off-mono", "seconds": 2.5 },
    { "do": "assert", "path": "measure.off-mono.integratedLufs", "approx": -20, "tol": 0.5 },
    { "do": "play", "title": "Mid" },
    { "do": "waitUntil", "path": "player.position", "gt": 0.3, "timeout": 3 },

    { "do": "setNormalization", "value": "track" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "assert", "path": "player.gainDb", "approx": 2, "tol": 0.1 },
    { "do": "measure", "name": "track-mid", "seconds": 2.5 },
    { "do": "assert", "path": "measure.track-mid.integratedLufs", "approx": -18, "tol": 0.5 },
    { "do": "play", "title": "Loud" },
    { "do": "waitUntil", "path": "player.position", "gt": 0.3, "timeout": 3 },
    { "do": "measure", "name": "track-loud", "seconds": 2.5 },
    { "do": "assert", "path": "measure.track-loud.integratedLufs", "approx": -18, "tol": 0.5 },
    { "do": "play", "title": "Quiet" },
    { "do": "waitUntil", "path": "player.position", "gt": 0.3, "timeout": 3 },
    { "do": "measure", "name": "track-quiet", "seconds": 2.5 },
    { "do": "assert", "path": "measure.track-quiet.integratedLufs", "approx": -18, "tol": 0.5 },
    { "do": "play", "title": "Mono" },
    { "do": "waitUntil", "path": "player.position", "gt": 0.3, "timeout": 3 },
    { "do": "measure", "name": "track-mono", "seconds": 2.5 },
    { "do": "assert", "path": "measure.track-mono.integratedLufs", "approx": -18, "tol": 0.5 },
    { "do": "play", "title": "Step 1" },
    { "do": "seek", "seconds": 3.5 },
    { "do": "waitUntil", "path": "player.position", "gt": 3.6, "timeout": 3 },
    { "do": "measure", "name": "step", "seconds": 3 },
    { "do": "assert", "path": "player.title", "equals": "Step 2" },
    { "do": "assert", "path": "measure.step.longestGapMs", "lt": 1 },
    { "do": "assert", "path": "measure.step.maxStep", "lt": 0.02 },
    { "do": "play", "title": "Peaky" },
    { "do": "waitUntil", "path": "player.position", "gt": 0.3, "timeout": 3 },
    { "do": "assert", "path": "player.gainDb", "lt": 0 },
    { "do": "measure", "name": "track-peaky", "seconds": 2.5 },
    { "do": "assert", "path": "measure.track-peaky.peakDbfs", "lt": -0.4 },

    { "do": "setNormalization", "value": "album" },
    { "do": "play", "title": "Quiet" },
    { "do": "waitUntil", "path": "player.position", "gt": 0.3, "timeout": 3 },
    { "do": "assert", "path": "player.gainDb", "approx": -10, "tol": 0.1 },
    { "do": "measure", "name": "album-quiet", "seconds": 2.5 },
    { "do": "assert", "path": "measure.album-quiet.integratedLufs", "approx": -40, "tol": 0.5 },
    { "do": "play", "title": "Loud" },
    { "do": "assert", "path": "player.gainDb", "approx": -10, "tol": 0.1 },
    { "do": "play", "title": "Mid" },
    { "do": "assert", "path": "player.gainDb", "approx": 2, "tol": 0.1 },
    { "do": "play", "title": "Part 1" },
    { "do": "seek", "seconds": 3.5 },
    { "do": "waitUntil", "path": "player.position", "gt": 3.6, "timeout": 3 },
    { "do": "measure", "name": "gapless", "seconds": 3 },
    { "do": "assert", "path": "player.title", "equals": "Part 2" },
    { "do": "assert", "path": "measure.gapless.longestGapMs", "lt": 1 },
    { "do": "assert", "path": "measure.gapless.maxStep", "lt": 0.02 },
    { "do": "snapshot", "name": "player-bar" },
    { "do": "openSettings" },
    { "do": "snapshot", "name": "settings", "window": "settings" },
    { "do": "state", "name": "end" }
  ]
}
