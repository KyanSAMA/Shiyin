{
  "timeout": 120,
  "window": { "width": 1280, "height": 800 },
  "steps": [
    { "do": "fs", "op": "copy", "from": "@fixtures/loudness", "to": "@out/ln" },
    { "do": "startLibrary", "include": ["@out/ln"] },
    { "do": "waitUntil", "path": "loudness.pending", "equals": 0, "timeout": 40 },
    { "do": "setOutputDevice", "uid": "fake-headphones" },
    { "do": "play", "title": "Mid" },
    { "do": "waitUntil", "path": "player.isPlaying", "equals": true, "timeout": 5 },
    { "do": "setVolume", "value": 0.4 },
    { "do": "assert", "path": "output.signalPath.untouched", "equals": false },
    { "do": "setPassthrough", "value": true },
    { "do": "assert", "path": "player.passthrough", "equals": true },
    { "do": "assert", "path": "player.gainDb", "equals": 0 },
    { "do": "assert", "path": "loudness.mode", "equals": "track" },
    { "do": "assert", "path": "output.deviceVolume", "approx": 0.2, "tol": 0.001 },
    { "do": "assert", "path": "player.shownVolume", "approx": 0.2, "tol": 0.001 },
    { "do": "assert", "path": "player.engineVolume", "equals": 0 },
    { "do": "assert", "path": "output.signalPath.untouched", "equals": true },
    { "do": "setVolume", "value": 0.3 },
    { "do": "assert", "path": "output.deviceVolume", "approx": 0.3, "tol": 0.001 },
    { "do": "assert", "path": "player.volume", "approx": 0.4, "tol": 0.001 },
    { "do": "pressKey", "key": "up", "modifiers": ["command"] },
    { "do": "assert", "path": "output.deviceVolume", "approx": 0.4, "tol": 0.001 },
    { "do": "setPassthrough", "value": false },
    { "do": "assert", "path": "output.deviceVolume", "approx": 1.0, "tol": 0.001 },
    { "do": "assert", "path": "output.signalPath.untouched", "equals": false },
    { "do": "setPassthrough", "value": true },
    { "do": "assert", "path": "output.deviceVolume", "approx": 0.4, "tol": 0.001 },
    { "do": "showSignalPath" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "signal-path", "window": "popover" },
    { "do": "snapshot", "name": "player-bar" },
    { "do": "appearance", "value": "dark" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "signal-path-dark", "window": "popover" },
    { "do": "showSignalPath", "value": false },
    { "do": "appearance", "value": "light" },
    { "do": "play", "title": "Mono" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "assert", "path": "output.signalPath.untouched", "equals": false },
    { "do": "setOutputDevice", "uid": "fake-dac" },
    { "do": "assert", "path": "player.shownVolume", "equals": null },
    { "do": "snapshot", "name": "device-volume" },
    { "do": "openSettings", "tab": 3 },
    { "do": "snapshot", "name": "settings", "window": "settings" },
    { "do": "setPassthrough", "value": false },
    { "do": "assert", "path": "player.passthrough", "equals": false },
    { "do": "assert", "path": "player.shownVolume", "approx": 0.4, "tol": 0.001 },
    { "do": "state", "name": "end" }
  ]
}
