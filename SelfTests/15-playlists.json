{
  "timeout": 60,
  "window": { "width": 1280, "height": 800 },
  "relaunch": "relaunch/15-playlists.json",
  "steps": [
    { "do": "fs", "op": "copy", "from": "@fixtures/library", "to": "@out/lib" },
    { "do": "startLibrary", "include": ["@out/lib"], "exclude": ["@out/lib/Music"] },
    { "do": "promptPlaylist" },
    { "do": "assert", "path": "ui.playlistPrompt", "equals": "新建播放列表" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "prompt" },
    { "do": "commitPlaylistPrompt", "name": "通勤" },
    { "do": "assert", "path": "ui.playlist", "equals": "通勤" },
    { "do": "assert", "path": "ui.visibleCount", "equals": 0 },
    { "do": "snapshot", "name": "playlist-empty" },
    { "do": "addToPlaylist", "name": "通勤", "titles": ["夜に駆ける", "群青", "春日影"] },
    { "do": "addToPlaylist", "name": "通勤", "titles": ["群青"] },
    { "do": "assert", "path": "ui.firstRows", "equals": ["夜に駆ける", "群青", "春日影"] },
    { "do": "movePlaylistTracks", "name": "通勤", "titles": ["春日影"], "to": 0 },
    { "do": "assert", "path": "ui.firstRows", "equals": ["春日影", "夜に駆ける", "群青"] },
    { "do": "movePlaylistTracks", "name": "通勤", "titles": ["春日影"], "to": 3 },
    { "do": "assert", "path": "ui.firstRows", "equals": ["夜に駆ける", "群青", "春日影"] },
    { "do": "removeFromPlaylist", "name": "通勤", "titles": ["夜に駆ける"] },
    { "do": "assert", "path": "library.playlists.0.titles", "equals": ["群青", "春日影"] },
    { "do": "search", "value": "群" },
    { "do": "assert", "path": "ui.firstRows", "equals": ["群青"] },
    { "do": "search", "value": "" },
    { "do": "promptPlaylist", "titles": ["Part 1", "Part 2"] },
    { "do": "commitPlaylistPrompt", "name": "临时" },
    { "do": "assert", "path": "ui.playlist", "equals": "通勤" },
    { "do": "assert", "path": "library.playlists.1.titles", "equals": ["Part 1", "Part 2"] },
    { "do": "sidebar", "value": "playlist", "name": "临时" },
    { "do": "deletePlaylist", "name": "临时" },
    { "do": "assert", "path": "ui.sidebar", "equals": "songs" },
    { "do": "promptPlaylist", "rename": "通勤" },
    { "do": "commitPlaylistPrompt", "name": "晚上" },
    { "do": "sidebar", "value": "playlist", "name": "晚上" },
    { "do": "play", "title": "群青" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "playlist" },
    { "do": "quit" }
  ]
}
