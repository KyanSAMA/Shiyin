{
  "timeout": 120,
  "window": { "width": 1280, "height": 800 },
  "relaunch": "hw-output-quit.json",
  "steps": [
    { "do": "fs", "op": "copy", "from": "@fixtures/library", "to": "@out/lib" },
    { "do": "startLibrary", "include": ["@out/lib"], "exclude": ["@out/lib/Music"] },
    { "do": "setOutputDevice", "uid": "BuiltInHeadphoneOutputDevice" },
    { "do": "assert", "path": "output.effectiveRate", "equals": 48000 },
    { "do": "setFollowRate", "value": true },
    { "do": "assert", "path": "output.following", "equals": true },
    { "do": "play", "title": "ID3v2.4 测试" },
    { "do": "waitSwitch" },
    { "do": "state", "name": "to-44k" },
    { "do": "assert", "path": "output.switchFailure", "equals": null },
    { "do": "assert", "path": "output.effectiveRate", "equals": 44100 },
    { "do": "assert", "path": "player.outputSampleRate", "equals": 44100 },
    { "do": "measure", "name": "at44k", "seconds": 0.5 },
    { "do": "assert", "path": "measure.at44k.rmsDbfs", "gt": -40 },
    { "do": "play", "title": "春日影" },
    { "do": "waitSwitch" },
    { "do": "state", "name": "to-48k" },
    { "do": "assert", "path": "output.effectiveRate", "equals": 48000 },
    { "do": "assert", "path": "player.outputSampleRate", "equals": 48000 },
    { "do": "play", "title": "Hi-Res 192k", "context": "songs" },
    { "do": "waitSwitch" },
    { "do": "state", "name": "to-96k" },
    { "do": "assert", "path": "output.effectiveRate", "equals": 96000 },
    { "do": "assert", "path": "player.outputSampleRate", "equals": 96000 },
    { "do": "assert", "path": "output.signalPath.resampled", "equals": true },
    { "do": "measure", "name": "at96k", "seconds": 0.5 },
    { "do": "assert", "path": "measure.at96k.rmsDbfs", "gt": -40 },
    { "do": "waitUntil", "path": "player.title", "equals": "ID3v2.4 测试", "timeout": 8 },
    { "do": "waitSwitch" },
    { "do": "state", "name": "boundary" },
    { "do": "assert", "path": "output.effectiveRate", "equals": 44100 },
    { "do": "assert", "path": "player.isPlaying", "equals": true },
    { "do": "setVolume", "value": 0.5 },
    { "do": "setPassthrough", "value": true },
    { "do": "wait", "seconds": 0.5 },
    { "do": "state", "name": "passthrough-on" },
    { "do": "assert", "path": "output.deviceVolume", "approx": 0.014, "tol": 0.01 },
    { "do": "setPassthrough", "value": false },
    { "do": "wait", "seconds": 0.5 },
    { "do": "state", "name": "passthrough-off" },
    { "do": "assert", "path": "output.deviceVolume", "approx": 0.028, "tol": 0.01 },
    { "do": "setFollowRate", "value": false },
    { "do": "wait", "seconds": 0.5 },
    { "do": "state", "name": "follow-off" },
    { "do": "assert", "path": "output.effectiveRate", "equals": 48000 },
    { "do": "assert", "path": "output.restores", "equals": {} },
    { "do": "setFollowRate", "value": true },
    { "do": "play", "title": "ID3v2.4 测试" },
    { "do": "waitSwitch" },
    { "do": "assert", "path": "output.effectiveRate", "equals": 44100 },
    { "do": "quit" }
  ]
}
