{
  "timeout": 90,
  "window": { "width": 1280, "height": 800 },
  "relaunch": "relaunch/24-follow-rate.json",
  "steps": [
    { "do": "fs", "op": "copy", "from": "@fixtures/library", "to": "@out/lib" },
    { "do": "startLibrary", "include": ["@out/lib"], "exclude": ["@out/lib/Music"] },
    { "do": "setOutputDevice", "uid": "fake-headphones" },
    { "do": "setFollowRate", "value": true },
    { "do": "assert", "path": "output.following", "equals": true },
    { "do": "play", "title": "春日影" },
    { "do": "waitSwitch" },
    { "do": "assert", "path": "player.outputSampleRate", "equals": 48000 },
    { "do": "assert", "path": "output.lastSwitch", "equals": null },
    { "do": "play", "title": "ID3v2.4 测试" },
    { "do": "waitSwitch" },
    { "do": "assert", "path": "player.isPlaying", "equals": true },
    { "do": "assert", "path": "player.outputSampleRate", "equals": 44100 },
    { "do": "assert", "path": "output.devices.1.rate", "equals": 44100 },
    { "do": "assert", "path": "output.restores.fake-headphones.originalRate", "equals": 48000 },
    { "do": "assert", "path": "output.lastSwitch.ms", "lt": 1500 },
    { "do": "measure", "name": "switched", "seconds": 0.5 },
    { "do": "assert", "path": "measure.switched.rmsDbfs", "gt": -30 },
    { "do": "play", "title": "Hi-Res 192k" },
    { "do": "waitSwitch" },
    { "do": "assert", "path": "player.outputSampleRate", "equals": 96000 },
    { "do": "assert", "path": "player.fileSampleRate", "equals": 192000 },
    { "do": "fakeOutput", "op": "failNextSwitch", "uid": "fake-headphones" },
    { "do": "play", "title": "ID3v2.4 测试" },
    { "do": "waitSwitch" },
    { "do": "assert", "path": "player.isPlaying", "equals": true },
    { "do": "assert", "path": "player.outputSampleRate", "equals": 96000 },
    { "do": "assert", "path": "output.switchFailure", "equals": "无法切换到 44.1 kHz" },
    { "do": "openSettings", "tab": 3 },
    { "do": "snapshot", "name": "settings-failed", "window": "settings" },
    { "do": "setOutputDevice", "uid": "fake-airpods" },
    { "do": "assert", "path": "output.canFollow", "equals": false },
    { "do": "assert", "path": "output.following", "equals": false },
    { "do": "assert", "path": "output.devices.1.rate", "equals": 48000 },
    { "do": "assert", "path": "output.restores", "equals": {} },
    { "do": "snapshot", "name": "settings-bluetooth", "window": "settings" },
    { "do": "setOutputDevice", "uid": "fake-headphones" },
    { "do": "play", "title": "Hi-Res 192k" },
    { "do": "waitSwitch" },
    { "do": "assert", "path": "output.devices.1.rate", "equals": 96000 },
    { "do": "snapshot", "name": "settings", "window": "settings" },
    { "do": "appearance", "value": "dark" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "settings-dark", "window": "settings" },
    { "do": "setFollowRate", "value": false },
    { "do": "assert", "path": "output.devices.1.rate", "equals": 48000 },
    { "do": "assert", "path": "player.outputSampleRate", "equals": 48000 },
    { "do": "assert", "path": "output.restores", "equals": {} },
    { "do": "setFollowRate", "value": true },
    { "do": "play", "title": "ID3v2.4 测试" },
    { "do": "waitSwitch" },
    { "do": "assert", "path": "output.devices.1.rate", "equals": 44100 },
    { "do": "quit" }
  ]
}
