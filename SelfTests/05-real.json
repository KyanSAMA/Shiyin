{
  "timeout": 150,
  "window": { "width": 1280, "height": 800 },
  "steps": [
    { "do": "startLibrary" },
    { "do": "wait", "seconds": 1 },
    { "do": "perfReset" },
    { "do": "scrollList", "steps": 30 },
    { "do": "state", "name": "songs-cold" },
    { "do": "assert", "path": "perf.maxMainThreadStallMs", "lt": 100 },
    { "do": "scrollList", "steps": 0, "interval": 0.5 },
    { "do": "perfReset" },
    { "do": "scrollList", "steps": 120, "interval": 0.03 },
    { "do": "state", "name": "songs-warm" },
    { "do": "assert", "path": "perf.stallsOver50ms", "lt": 2 },
    { "do": "assert", "path": "perf.maxMainThreadStallMs", "lt": 80 },
    { "do": "snapshot", "name": "songs" },
    { "do": "search", "value": "yoasobi" },
    { "do": "perfReset" },
    { "do": "search", "value": "" },
    { "do": "state", "name": "search-clear" },
    { "do": "assert", "path": "perf.maxMainThreadStallMs", "lt": 400 },
    { "do": "search", "value": "さかなくしょん" },
    { "do": "assert", "path": "ui.visibleCount", "gt": 3 },
    { "do": "search", "value": "" },
    { "do": "sidebar", "value": "albums" },
    { "do": "wait", "seconds": 1 },
    { "do": "perfReset" },
    { "do": "scrollList", "steps": 30 },
    { "do": "state", "name": "albums-cold" },
    { "do": "assert", "path": "perf.maxMainThreadStallMs", "lt": 100 },
    { "do": "snapshot", "name": "albums-bottom" },
    { "do": "openAlbum", "title": "迷跡波" },
    { "do": "wait", "seconds": 1 },
    { "do": "snapshot", "name": "album" },
    { "do": "sidebar", "value": "composers" },
    { "do": "snapshot", "name": "composers" },
    { "do": "state", "name": "end" }
  ]
}
