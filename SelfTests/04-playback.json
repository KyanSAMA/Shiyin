{
  "timeout": 120,
  "window": { "width": 1280, "height": 800 },
  "steps": [
    { "do": "fs", "op": "copy", "from": "@fixtures/library", "to": "@out/lib" },
    { "do": "startLibrary", "include": ["@out/lib"], "exclude": ["@out/lib/Music"] },
    { "do": "play", "title": "Part 1" },
    { "do": "waitUntil", "path": "player.isPlaying", "equals": true, "timeout": 5 },
    { "do": "assert", "path": "player.engineVolume", "equals": 0 },
    { "do": "assert", "path": "player.queue.count", "equals": 2 },
    { "do": "seek", "seconds": 3.5 },
    { "do": "waitUntil", "path": "player.position", "gt": 3.6, "timeout": 3 },
    { "do": "measure", "name": "boundary", "seconds": 3 },
    { "do": "assert", "path": "player.title", "equals": "Part 2" },
    { "do": "assert", "path": "measure.boundary.longestGapMs", "lt": 1 },
    { "do": "assert", "path": "measure.boundary.maxStep", "lt": 0.02 },
    { "do": "assert", "path": "measure.boundary.rmsDbfs", "gt": -30 },
    { "do": "snapshot", "name": "player-bar" },
    { "do": "seek", "seconds": 3.0 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "assert", "path": "player.position", "approx": 3.5, "tol": 0.3 },
    { "do": "previous" },
    { "do": "assert", "path": "player.position", "lt": 0.5 },
    { "do": "previous" },
    { "do": "assert", "path": "player.title", "equals": "Part 1" },
    { "do": "pause" },
    { "do": "assert", "path": "player.isPlaying", "equals": false },
    { "do": "togglePlayPause" },
    { "do": "assert", "path": "player.isPlaying", "equals": true },
    { "do": "setShuffle", "value": true },
    { "do": "assert", "path": "player.queue.shuffled", "equals": true },
    { "do": "assert", "path": "player.title", "equals": "Part 1" },
    { "do": "play", "title": "Hi-Res 192k" },
    { "do": "setRepeat", "value": "one" },
    { "do": "waitUntil", "path": "player.position", "gt": 0.5, "timeout": 3 },
    { "do": "assert", "path": "player.fileSampleRate", "equals": 192000 },
    { "do": "wait", "seconds": 2.5 },
    { "do": "assert", "path": "player.isPlaying", "equals": true },
    { "do": "assert", "path": "player.title", "equals": "Hi-Res 192k" },
    { "do": "setRepeat", "value": "off" },
    { "do": "waitUntil", "path": "player.isPlaying", "equals": false, "timeout": 4 },
    { "do": "enableNowPlaying" },
    { "do": "play", "title": "夜に駆ける" },
    { "do": "wait", "seconds": 1 },
    { "do": "assert", "path": "nowPlayingInfo.title", "equals": "夜に駆ける" },
    { "do": "assert", "path": "nowPlayingInfo.rate", "equals": 1 },
    { "do": "snapshot", "name": "playing" },
    { "do": "state", "name": "end" }
  ]
}
