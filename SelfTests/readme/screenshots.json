{
  "timeout": 180,
  "window": { "width": 1440, "height": 900 },
  "steps": [
    { "do": "hideSidebar", "values": ["netease"] },
    { "do": "startLibrary" },
    { "do": "play", "title": "グッドバイ", "context": "songs" },
    { "do": "waitUntil", "path": "lyrics.lineCount", "gt": 20, "timeout": 5 },
    { "do": "seek", "seconds": 62 },
    { "do": "wait", "seconds": 1 },
    { "do": "pause" },
    { "do": "sidebar", "value": "albums" },
    { "do": "wait", "seconds": 2 },
    { "do": "snapshot", "name": "albums" },
    { "do": "openAlbum", "title": "棘アリ" },
    { "do": "wait", "seconds": 1 },
    { "do": "snapshot", "name": "album" },
    { "do": "back" },
    { "do": "showNowPlaying" },
    { "do": "wait", "seconds": 1.5 },
    { "do": "snapshot", "name": "nowplaying" },
    { "do": "showNowPlaying", "value": false },
    { "do": "openPerson", "name": "MyGO!!!!!" },
    { "do": "wait", "seconds": 1 },
    { "do": "snapshot", "name": "artist" },
    { "do": "sidebar", "value": "enrich" },
    { "do": "wait", "seconds": 1 },
    { "do": "snapshot", "name": "enrich" },
    { "do": "sirenAlbum", "name": "直到大地变成一颗酸橙OST" },
    { "do": "sidebar", "value": "siren" },
    { "do": "wait", "seconds": 4 },
    { "do": "snapshot", "name": "siren" },
    { "do": "appearance", "value": "dark" },
    { "do": "sidebar", "value": "albums" },
    { "do": "wait", "seconds": 1.5 },
    { "do": "snapshot", "name": "albums-dark" }
  ]
}
