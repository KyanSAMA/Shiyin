{
  "timeout": 90,
  "window": { "width": 1280, "height": 800 },
  "steps": [
    { "do": "fs", "op": "copy", "from": "@fixtures/library", "to": "@out/lib" },
    { "do": "startLibrary", "include": ["@out/lib"], "exclude": ["@out/lib/Music"] },
    { "do": "wait", "seconds": 1 },
    { "do": "snapshot", "name": "songs" },
    { "do": "sort", "column": "year", "ascending": false },
    { "do": "assert", "path": "ui.firstRows.0", "equals": "Hi-Res 192k" },
    { "do": "sort", "column": "title", "ascending": true },
    { "do": "search", "value": "yoasobi" },
    { "do": "assert", "path": "ui.visibleCount", "equals": 2 },
    { "do": "search", "value": "ｍｙｇｏ" },
    { "do": "assert", "path": "ui.firstRows", "contains": "春日影" },
    { "do": "search", "value": "" },
    { "do": "sidebar", "value": "albums" },
    { "do": "assert", "path": "ui.visibleCount", "equals": 7 },
    { "do": "wait", "seconds": 1 },
    { "do": "snapshot", "name": "albums" },
    { "do": "openAlbum", "title": "THE BOOK" },
    { "do": "assert", "path": "ui.firstRows", "equals": ["夜に駆ける", "群青"] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "album-detail" },
    { "do": "back" },
    { "do": "sidebar", "value": "artists" },
    { "do": "assert", "path": "ui.visibleCount", "equals": 10 },
    { "do": "snapshot", "name": "artists" },
    { "do": "openPerson", "name": "YOASOBI" },
    { "do": "assert", "path": "ui.visibleCount", "equals": 2 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "artist-detail" },
    { "do": "sidebar", "value": "composers" },
    { "do": "assert", "path": "ui.firstRows", "contains": "未知" },
    { "do": "assert", "path": "ui.visibleCount", "equals": 3 },
    { "do": "state", "name": "end" }
  ]
}
