{
  "timeout": 90,
  "window": { "width": 1280, "height": 800 },
  "steps": [
    { "do": "fs", "op": "copy", "from": "@fixtures/library", "to": "@out/lib" },
    { "do": "startLibrary", "include": ["@out/lib"], "exclude": ["@out/lib/Music"] },
    { "do": "setOutputDevice", "uid": "default" },
    { "do": "assert", "path": "output.effective", "equals": "fake-speakers" },
    { "do": "setOutputDevice", "uid": "fake-headphones" },
    { "do": "assert", "path": "output.effective", "equals": "fake-headphones" },
    { "do": "play", "title": "Part 1" },
    { "do": "waitUntil", "path": "player.isPlaying", "equals": true, "timeout": 5 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "fakeOutput", "op": "unplug", "uid": "fake-headphones" },
    { "do": "assert", "path": "player.isPlaying", "equals": false },
    { "do": "assert", "path": "output.effective", "equals": "fake-speakers" },
    { "do": "assert", "path": "output.missing", "equals": "外置耳机" },
    { "do": "openSettings", "tab": 3 },
    { "do": "snapshot", "name": "settings-missing", "window": "settings" },
    { "do": "fakeOutput", "op": "plug", "uid": "fake-headphones" },
    { "do": "assert", "path": "output.effective", "equals": "fake-headphones" },
    { "do": "assert", "path": "output.missing", "equals": null },
    { "do": "assert", "path": "player.isPlaying", "equals": false },
    { "do": "setOutputDevice", "uid": "default" },
    { "do": "assert", "path": "output.effective", "equals": "fake-speakers" },
    { "do": "togglePlayPause" },
    { "do": "seek", "seconds": 2.0 },
    { "do": "wait", "seconds": 0.3 },
    { "do": "fakeOutput", "op": "setDefault", "uid": "fake-headphones" },
    { "do": "assert", "path": "output.effective", "equals": "fake-headphones" },
    { "do": "assert", "path": "player.isPlaying", "equals": true },
    { "do": "assert", "path": "player.position", "gt": 2.25 },
    { "do": "assert", "path": "player.position", "lt": 2.9 },
    { "do": "measure", "name": "moved", "seconds": 0.5 },
    { "do": "assert", "path": "measure.moved.rmsDbfs", "gt": -30 },
    { "do": "snapshot", "name": "settings", "window": "settings" },
    { "do": "appearance", "value": "dark" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "settings-dark", "window": "settings" },
    { "do": "state", "name": "end" }
  ]
}
