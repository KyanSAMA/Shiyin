{
  "timeout": 90,
  "window": { "width": 1280, "height": 800 },
  "steps": [
    { "do": "fs", "op": "copy", "from": "@fixtures/library", "to": "@out/lib" },
    { "do": "startLibrary", "include": ["@out/lib"], "exclude": ["@out/lib/Music"] },
    { "do": "waitUntil", "path": "library.trackCount", "equals": 11 },
    { "do": "filter", "formats": ["FLAC"] },
    { "do": "assert", "path": "ui.visibleCount", "equals": 7 },
    { "do": "filter", "formats": ["FLAC", "MP3"] },
    { "do": "assert", "path": "ui.visibleCount", "equals": 9 },
    { "do": "filter", "formats": ["FLAC"], "hiRes": true },
    { "do": "assert", "path": "ui.visibleCount", "equals": 2 },
    { "do": "assert", "path": "ui.firstRows", "contains": "Hi-Res 192k" },
    { "do": "filter", "years": [2021, 2024] },
    { "do": "assert", "path": "ui.visibleCount", "equals": 3 },
    { "do": "filter", "albumArtists": ["YOASOBI"], "hasLyrics": false },
    { "do": "assert", "path": "ui.firstRows", "equals": ["群青"] },
    { "do": "filter", "genres": ["J-Pop"] },
    { "do": "assert", "path": "ui.firstRows", "equals": ["夜に駆ける"] },
    { "do": "filter", "albumArtists": ["未知"] },
    { "do": "assert", "path": "ui.visibleCount", "equals": 3 },
    { "do": "filter", "genres": ["j-POP"] },
    { "do": "assert", "path": "ui.firstRows", "equals": ["夜に駆ける"] },
    { "do": "filter", "years": [1999] },
    { "do": "assert", "path": "ui.visibleCount", "equals": 0 },
    { "do": "snapshot", "name": "filter-empty" },
    { "do": "filter", "albumArtists": ["YOASOBI", "Test Tone"], "formats": ["FLAC", "MP3"], "hiRes": false },
    { "do": "assert", "path": "ui.visibleCount", "equals": 3 },
    { "do": "assert", "path": "ui.firstRows", "contains": "群青" },
    { "do": "assert", "path": "ui.filterChips", "equals": ["专辑艺人 Test Tone", "专辑艺人 YOASOBI", "FLAC", "MP3", "非 Hi-Res"] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "songs-filtered" },
    { "do": "appearance", "value": "dark" },
    { "do": "snapshot", "name": "songs-filtered-dark" },
    { "do": "appearance", "value": "light" },
    { "do": "filter", "hiRes": true },
    { "do": "sidebar", "value": "albums" },
    { "do": "assert", "path": "ui.visibleCount", "equals": 2 },
    { "do": "assert", "path": "ui.firstRows", "contains": "THE BOOK" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "albums-hires" },
    { "do": "openAlbum", "title": "THE BOOK" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "album-detail-unfiltered" },
    { "do": "back" },
    { "do": "sidebar", "value": "artists" },
    { "do": "assert", "path": "ui.visibleCount", "equals": 3 },
    { "do": "assert", "path": "ui.firstRows", "contains": "小山百代" },
    { "do": "search", "value": "zzz" },
    { "do": "assert", "path": "ui.visibleCount", "equals": 0 },
    { "do": "snapshot", "name": "no-results" },
    { "do": "search", "value": "" },
    { "do": "filter" },
    { "do": "sidebar", "value": "songs" },
    { "do": "assert", "path": "ui.visibleCount", "equals": 11 },
    { "do": "assert", "path": "ui.filterChips", "equals": [] },
    { "do": "state", "name": "end" }
  ]
}
