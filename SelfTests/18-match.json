{
  "timeout": 60,
  "window": { "width": 1440, "height": 900 },
  "relaunch": "relaunch/18-match.json",
  "steps": [
    { "do": "fs", "op": "copy", "from": "@fixtures/library", "to": "@out/lib" },
    { "do": "startLibrary", "include": ["@out/lib"], "exclude": ["@out/lib/Music"] },
    { "do": "chooseMatch", "title": "春日影" },
    { "do": "assert", "path": "picker.stored", "equals": false },
    { "do": "assert", "path": "picker.results", "equals": ["netease:2001", "itunes:1700000001", "netease:2002"] },
    { "do": "assert", "path": "picker.status.qq", "equals": 0 },
    { "do": "assert", "path": "picker.selected", "equals": "netease:2001" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "snapshot", "name": "match-light", "window": "sheet" },
    { "do": "appearance", "value": "dark" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "match-dark", "window": "sheet" },
    { "do": "appearance", "value": "light" },
    { "do": "searchMatch", "keywords": "春日影" },
    { "do": "assert", "path": "picker.results", "equals": [] },
    { "do": "searchMatch", "keywords": "春日影 MyGO!!!!!" },
    { "do": "adoptMatch", "key": "itunes:1700000001" },
    { "do": "inspect", "title": "春日影" },
    { "do": "assert", "path": "inspected.春日影.match", "equals": "confirmed" },
    { "do": "assert", "path": "inspected.春日影.genre", "equals": "Anime" },
    { "do": "assert", "path": "inspected.春日影.year", "equals": 2023 },
    { "do": "assert", "path": "inspected.春日影.hasLyrics", "equals": true },
    { "do": "assert", "path": "inspected.春日影.coverFile", "equals": true },
    { "do": "editInfo", "titles": ["春日影"], "keepOpen": true, "suggest": { "year": "itunes", "cover": "itunes" } },
    { "do": "assert", "path": "editor.sources", "equals": ["netease", "itunes"] },
    { "do": "assert", "path": "editor.texts.year", "equals": "2024" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "snapshot", "name": "editor", "window": "sheet" },
    { "do": "saveEditInfo" },
    { "do": "inspect", "title": "春日影" },
    { "do": "assert", "path": "inspected.春日影.year", "equals": 2024 },
    { "do": "assert", "path": "inspected.春日影.userCover", "equals": true },
    { "do": "assert", "path": "inspected.春日影.album", "equals": "迷跡波" },
    { "do": "quit" }
  ]
}
