{
  "timeout": 90,
  "window": { "width": 1280, "height": 800 },
  "relaunch": "relaunch/17-enrich.json",
  "steps": [
    { "do": "fs", "op": "copy", "from": "@fixtures/library", "to": "@out/lib" },
    { "do": "startLibrary", "include": ["@out/lib"], "exclude": ["@out/lib/Music"] },
    { "do": "sidebar", "value": "enrich" },
    { "do": "enrichFilter", "value": "missingLyrics" },
    { "do": "assert", "path": "enrich.counts.missingLyrics", "equals": 9 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "before" },
    { "do": "enrich" },
    { "do": "assert", "path": "enrich.auto", "equals": ["春日影", "直到大地变成一颗酸橙", "群青"] },
    { "do": "assert", "path": "enrich.pending", "equals": ["无标签标题"] },
    { "do": "assert", "path": "enrich.counts.missingLyrics", "equals": 6 },
    { "do": "inspect", "title": "春日影" },
    { "do": "assert", "path": "inspected.春日影.year", "equals": 2023 },
    { "do": "assert", "path": "inspected.春日影.trackNo", "equals": 3 },
    { "do": "assert", "path": "inspected.春日影.album", "equals": "迷跡波" },
    { "do": "assert", "path": "inspected.春日影.coverFile", "equals": true },
    { "do": "assert", "path": "inspected.春日影.hasLyrics", "equals": true },
    { "do": "assert", "path": "inspected.春日影.genre", "equals": "Anime" },
    { "do": "inspect", "title": "直到大地变成一颗酸橙" },
    { "do": "assert", "path": "inspected.直到大地变成一颗酸橙.year", "equals": 2021 },
    { "do": "assert", "path": "inspected.直到大地变成一颗酸橙.trackNo", "equals": 2 },
    { "do": "assert", "path": "inspected.直到大地变成一颗酸橙.hasLyrics", "equals": true },
    { "do": "assert", "path": "inspected.直到大地变成一颗酸橙.composers", "equals": ["平林佑人"] },
    { "do": "setSources", "order": ["itunes", "netease", "qq", "lrclib"] },
    { "do": "inspect", "title": "春日影" },
    { "do": "assert", "path": "inspected.春日影.year", "equals": 2024 },
    { "do": "assert", "path": "enrich.requests.u_y_qq_com", "equals": 8 },
    { "do": "setSources", "order": ["netease", "qq", "itunes", "lrclib"], "disabled": ["qq"] },
    { "do": "enrich", "titles": ["直到大地变成一颗酸橙"] },
    { "do": "assert", "path": "enrich.requests.u_y_qq_com", "equals": 8 },
    { "do": "setSources", "disabled": [] },
    { "do": "inspect", "title": "群青" },
    { "do": "assert", "path": "inspected.群青.trackNo", "equals": 2 },
    { "do": "assert", "path": "inspected.群青.coverFile", "equals": false },
    { "do": "assert", "path": "inspected.群青.composers", "equals": ["Ayase"] },
    { "do": "enrich", "titles": ["春日影", "群青"] },
    { "do": "inspect", "title": "春日影" },
    { "do": "assert", "path": "inspected.春日影.hasLyrics", "equals": true },
    { "do": "assert", "path": "inspected.春日影.coverFile", "equals": true },
    { "do": "enrich" },
    { "do": "assert", "path": "enrich.notice", "equals": "没有需要补全的歌曲" },
    { "do": "enrichFilter", "value": "pending" },
    { "do": "openCandidates", "title": "无标签标题" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "snapshot", "name": "candidates", "window": "sheet" },
    { "do": "chooseCandidate", "title": "无标签标题", "index": 0 },
    { "do": "assert", "path": "enrich.counts.missingLyrics", "equals": 5 },
    { "do": "inspect", "title": "无标签标题" },
    { "do": "assert", "path": "inspected.无标签标题.match", "equals": "confirmed" },
    { "do": "assert", "path": "inspected.无标签标题.album", "equals": "某张专辑" },
    { "do": "assert", "path": "inspected.无标签标题.year", "equals": 2020 },
    { "do": "assert", "path": "inspected.无标签标题.coverFile", "equals": true },
    { "do": "rejectMatch", "title": "群青" },
    { "do": "inspect", "title": "群青" },
    { "do": "assert", "path": "inspected.群青.match", "equals": "rejected" },
    { "do": "assert", "path": "inspected.群青.hasLyrics", "equals": false },
    { "do": "enrichFilter", "value": "done" },
    { "do": "assert", "path": "ui.visibleCount", "equals": 3 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "done" },
    { "do": "play", "title": "春日影" },
    { "do": "pause" },
    { "do": "showNowPlaying" },
    { "do": "waitUntil", "path": "lyrics.lineCount", "equals": 4, "timeout": 5 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "lyrics" },
    { "do": "setSources", "disabled": ["lrclib"] },
    { "do": "openSettings", "tab": 1 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "snapshot", "name": "settings", "window": "settings" },
    { "do": "quit" }
  ]
}
